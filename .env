# ── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Service role key — SECRET, server-only. Used by scripts/checkPrices.js
# to read/update every user's tracked flights (bypasses Row Level Security
# on purpose). Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── RapidAPI: Flights Sky (Skyscanner scraper) ──────────────────────
# rapidapi.com → search "Flights Sky" (host: flights-sky.p.rapidapi.com)
# → Subscribe to the free tier → copy your key from the code snippet panel.
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=flights-sky.p.rapidapi.com

# Set to "true" only for local UI development without a RapidAPI key.
# When false, a failed request surfaces as a real error instead of
# silently showing fake prices.
USE_MOCK_FLIGHTS=true

# ── Email (Resend) ───────────────────────────────────────────────────
EMAIL_API_KEY=your_resend_api_key
EMAIL_FROM="FlightTracker <alerts@yourdomain.com>"

# ── Vercel Cron (production only — not needed for local dev) ───────
# Generate any random string (e.g. `openssl rand -hex 32`) and set it as
# CRON_SECRET in your Vercel project's Environment Variables. Vercel then
# automatically sends it as a Bearer token when it triggers your cron job,
# which app/api/cron/check-prices/route.js checks before doing any work.
CRON_SECRET=
